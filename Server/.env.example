HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/atlas.sqlite
# Private original-file storage. Never put it inside a public web/static directory.
ASSET_DIRECTORY=./data/assets
# Baseline beta storage reservation per organization, in bytes (8 GiB default).
MAX_ORGANIZATION_ASSET_BYTES=8589934592
# Comma-separated browser origins. Native iOS requests do not require CORS.
CORS_ORIGINS=

# Optional real Apple verification. Keep all variables absent for local prototype mode.
# Production requires the numeric app ID from App Store Connect.
# APPLE_BUNDLE_ID=com.atlasfield.app
# APPLE_APP_ID=1234567890
# APPLE_ENVIRONMENT=Sandbox
# Comma-separated local Apple root certificates (DER or PEM), obtained from Apple PKI.
# APPLE_ROOT_CERT_PATHS=/etc/atlas/AppleRootCA-G3.cer,/etc/atlas/AppleRootCA-G2.cer
# Optional narrowing of the six fixed product IDs, never a client supplied mapping.
# APPLE_ALLOWED_PRODUCT_IDS=com.atlasfield.pro.monthly,com.atlasfield.pro.yearly,com.atlasfield.business3.monthly,com.atlasfield.business3.yearly,com.atlasfield.business10.monthly,com.atlasfield.business10.yearly
